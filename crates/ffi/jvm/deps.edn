;; For REPL work and quick test runs. Build the Java classes and stage the native library first:
;;   ./gradlew classes stageNatives
;; Gradle stays the build of record: `./gradlew check` runs everything.
{:paths ["src/main/clojure" "build/classes/java/main" "build/resources/main" "build/native-libs"]
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        org.jspecify/jspecify {:mvn/version "1.0.1"}}
 :aliases
 {:dev  {:jvm-opts ["--enable-native-access=ALL-UNNAMED"]}
  :test {:extra-paths ["src/test/clojure"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}}
         :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
         :main-opts ["-m" "sa.ingenious.test-runner"]}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2026.10.26"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src/main/clojure" "src/test/clojure"]}
  :fmt  {:replace-deps {dev.weavejester/cljfmt {:mvn/version "0.16.6"}}
         :main-opts ["-m" "cljfmt.main" "check" "src/main/clojure" "src/test/clojure"]}}}
